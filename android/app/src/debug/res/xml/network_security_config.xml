<?xml version="1.0" encoding="utf-8"?>
<!--
    Hanya untuk rakitan debug (lihat letaknya: src/debug/, bukan src/main/).

    Android memblokir HTTP polos sejak versi 9, dan gejalanya menyesatkan:
    permintaan ke server pengembangan di laptop gagal seperti tidak ada
    jaringan sama sekali — aplikasi menampilkan "Tidak ada koneksi internet"
    padahal servernya jelas hidup dan bisa dibuka dari browser laptop.

    Yang diizinkan hanya alamat pengembangan, satu per satu, bukan
    `cleartextTrafficPermitted` menyeluruh: sebuah izin global akan ikut
    melonggarkan panggilan ke server produksi bila alamatnya suatu saat salah
    ketik menjadi http://.

    - 10.0.2.2       : alamat khusus emulator Android untuk "laptop yang
                       menjalankan emulator ini". localhost di emulator berarti
                       emulator itu sendiri, bukan laptop Anda.
    - IP laptop      : berubah setiap kali berpindah jaringan (sudah tiga kali
                       dalam satu hari pengerjaan), dan gejala IP yang basi
                       adalah "Tidak ada koneksi internet" — kalimat yang
                       menunjuk ke arah yang salah. Periksa dengan `ip addr`,
                       lalu tambahkan di sini. Yang tidak pernah basi adalah
                       jalur `adb reverse` di bawah; pakai itu kalau bosan
                       mengejar angka.
    - 127.0.0.1      : dipakai oleh `adb reverse tcp:8080 tcp:8080`, yang
                       menembus WiFi lewat kabel USB. Ini jalan keluar saat
                       WiFi-nya mengisolasi antar-klien (lazim di jaringan
                       kampus dan kantor) sehingga HP tidak bisa melihat
                       laptop sama sekali.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">192.168.100.13</domain>
        <domain includeSubdomains="false">192.168.100.7</domain>
        <domain includeSubdomains="false">10.207.186.75</domain>
    </domain-config>
</network-security-config>
