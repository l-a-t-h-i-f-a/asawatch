<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        Izin — docs/rencana-produksi.md §4.4.

        Android 12 (API 31) memecah izin Bluetooth menjadi SCAN dan CONNECT.
        `neverForLocation` menyatakan bahwa aplikasi ini tidak menyimpulkan lokasi
        dari hasil pemindaian: itu benar (AsaWatch hanya mencari satu jam) dan
        membebaskan pengguna Android 12+ dari dialog izin lokasi.

        ACCESS_FINE_LOCATION tetap ada untuk Android 11 ke bawah, yang menurunkan
        pemindaian BLE ke izin lokasi, dan dibatasi `maxSdkVersion="30"` supaya
        tidak ikut diminta di versi yang tidak membutuhkannya.
    -->
    <!-- Masuk akun dan (nanti) cadangan data ke server AsaWatch. Sampai kini
         izin ini hanya ada di manifest debug — dipasang Flutter untuk hot
         reload — sehingga semuanya bekerja saat dikembangkan lalu gagal total
         di rakitan rilis, tanpa satu pun pesan yang menyebut izin. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Pengingat titik ukur (docs/jadwal-titik-ukur.md §6). Wajib sejak
         Android 13; tanpa ini notifikasinya dijadwalkan tetapi tidak pernah
         terlihat, dan gejalanya sama persis dengan penjadwalan yang gagal. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Titik ukur punya jendela toleransi semenit-menitan, jadi pengingatnya
         tidak boleh digeser Doze ke waktu yang nyaman bagi sistem. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Sesi bisa melintasi restart perangkat; tanpa ini seluruh pengingat yang
         sudah dijadwalkan hilang tanpa jejak. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        Sesi makan berlangsung ~2,5 jam, jauh lebih lama daripada umur proses
        Flutter di latar belakang. Yang dijaga foreground service ini bukan
        sekadar kenyamanan: `UKUR`, `ARM_TITIK`, dan lingkaran sambung ulang
        semuanya mati bersama prosesnya, sehingga titik `+1 jam` lewat tanpa
        satu pun perintah terkirim (rencana-produksi.md §7.1).

        Tipenya `connectedDevice`, dan itu bukan pilihan kosmetik. Sejak
        Android 14 tipe wajib dideklarasikan atau service-nya menolak jalan,
        dan `dataSync` — yang paling sering dicontohkan — dibatasi total 6 jam
        per 24 jam sejak Android 15. `connectedDevice` bebas dari batas itu dan
        memang menggambarkan apa yang sesungguhnya terjadi: aplikasi menjaga
        tautan ke satu perangkat BLE yang sedang dipakai.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!--
        BLE adalah syarat, bukan pelengkap: aplikasi ini tidak berguna sama sekali
        tanpa jamnya. `required="true"` membuat Play Store menyembunyikannya dari
        perangkat yang tidak punya BLE, bukan membiarkannya terpasang lalu gagal.
    -->
    <uses-feature android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <application
        android:label="AsaWatch"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!--
            Nama kelasnya milik paket dan tidak boleh diubah. `stopWithTask`
            sengaja **tidak** dipasang: sesi harus selamat melewati pengguna
            yang menggeser aplikasi dari daftar recent, yang justru kejadian
            paling lazim selama dua jam menunggu.
        -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="connectedDevice"
            android:exported="false" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
